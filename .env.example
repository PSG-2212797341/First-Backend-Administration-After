# ==========================================
# ⚙️ 项目环境变量模板 (请复制一份并重命名为 .env)
# ==========================================

# 服务环境
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# 日志等级
LOG_LEVEL=debug

# 云数据库链接
DATABASE_URL=mongodb+srv://<用户名>:<密码>@cluster0.rygeieo.mongodb.net/backend-dev?retryWrites=true&w=majority
TEST_DATABASE_URL=mongodb+srv://<用户名>:<密码>@cluster0.rygeieo.mongodb.net/backend-test?retryWrites=true&w=majority
DATABASE_USERNAME=
DATABASE_PASSWORD=

# JWT令牌设置
# 请使用复杂的随机字符串
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 邮件服务器配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=